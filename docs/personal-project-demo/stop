#!/bin/sh
# Demo stop script for the `project` widget: ends the tmux session that
# `start` created. Without a stop script the widget kills the session
# itself; a script is useful to also close editors, browsers, etc.
set -eu

PROJECT_DIR="${PROJECT_DIR:-$(CDPATH= cd -- "$(dirname "$0")" && pwd)}"
PROJECT_SESSION="${PROJECT_SESSION:-$(basename "$PROJECT_DIR" | tr '.: ' '___')}"

tmux kill-session -t "$PROJECT_SESSION" 2>/dev/null || true
