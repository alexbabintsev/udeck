#!/bin/sh
# Demo start script for the `project` widget.
#
# udeck runs it with the project directory as the working directory
# and exports PROJECT_DIR, PROJECT_SESSION, PROJECT_TERMINAL,
# PROJECT_EDITOR, PROJECT_EDITOR_SUBDIR and PROJECT_EDITOR_TARGET.
# The widget shows the project as running while the tmux session exists.
set -eu

PROJECT_DIR="${PROJECT_DIR:-$(CDPATH= cd -- "$(dirname "$0")" && pwd)}"
PROJECT_SESSION="${PROJECT_SESSION:-$(basename "$PROJECT_DIR" | tr '.: ' '___')}"
PROJECT_EDITOR="${PROJECT_EDITOR:-}"
PROJECT_EDITOR_TARGET="${PROJECT_EDITOR_TARGET:-$PROJECT_DIR}"

if tmux has-session -t "$PROJECT_SESSION" 2>/dev/null; then
  exit 0
fi

# One window with two panes; replace the commands with your own
# (dev server, queue worker, logs, ...).
tmux new-session -d -s "$PROJECT_SESSION" -n main -c "$PROJECT_DIR"
tmux split-window -h -t "$PROJECT_SESSION:0.0" -c "$PROJECT_DIR"
tmux send-keys -t "$PROJECT_SESSION:0.0" 'echo "project started"' C-m
tmux send-keys -t "$PROJECT_SESSION:0.1" 'ls' C-m

if [ -n "$PROJECT_EDITOR" ]; then
  /usr/bin/open -a "$PROJECT_EDITOR" "$PROJECT_EDITOR_TARGET" >/dev/null 2>&1 || true
fi
