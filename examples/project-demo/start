#!/bin/sh
set -eu

PROJECT_DIR="${PROJECT_DIR:-$(CDPATH= cd -- "$(dirname "$0")" && pwd)}"
PROJECT_SESSION="${PROJECT_SESSION:-$(basename "$PROJECT_DIR" | tr '.: ' '___')}"
PROJECT_TERMINAL="${PROJECT_TERMINAL:-iTerm}"
PROJECT_EDITOR="${PROJECT_EDITOR:-}"
PROJECT_EDITOR_TARGET="${PROJECT_EDITOR_TARGET:-$PROJECT_DIR}"
PROJECT_CHROME_PROJECT="${PROJECT_CHROME_PROJECT:-$(basename "$PROJECT_DIR")}"
SLATE_CLI_PATH="${SLATE_CLI_PATH:-/Volumes/Black/Projects/chrome-projects/cli/slate}"
SLATE_EXT_ID="${SLATE_EXT_ID:-jdkjlgbfdjgleildnodgnknmakniinjm}"

ATTACH_CMD="cd '$PROJECT_DIR' && exec tmux attach-session -t '$PROJECT_SESSION'"

iterm_focus_or_attach() {
  CLIENT_TTYS=$(tmux list-clients -t "$PROJECT_SESSION" -F '#{client_tty}' 2>/dev/null | tr '\n' '|' | sed 's/|$//')
  /usr/bin/osascript \
    -e "on run argv" \
    -e "set ttyList to item 1 of argv" \
    -e 'tell application "iTerm"' \
    -e "  activate" \
    -e "  set found to false" \
    -e "  if ttyList is not \"\" then" \
    -e "    repeat with w in windows" \
    -e "      repeat with t in tabs of w" \
    -e "        repeat with s in sessions of t" \
    -e "          set sTty to tty of s" \
    -e "          if ttyList contains sTty then" \
    -e "            select t" \
    -e "            select w" \
    -e "            set found to true" \
    -e "            exit repeat" \
    -e "          end if" \
    -e "        end repeat" \
    -e "        if found then exit repeat" \
    -e "      end repeat" \
    -e "      if found then exit repeat" \
    -e "    end repeat" \
    -e "  end if" \
    -e "  if not found then" \
    -e "    if (count of windows) = 0 then" \
    -e "      create window with default profile" \
    -e "    end if" \
    -e "    tell current window" \
    -e "      create tab with default profile" \
    -e "      tell current session of current tab to write text \"$ATTACH_CMD\"" \
    -e "    end tell" \
    -e "  end if" \
    -e "end tell" \
    -e "end run" \
    "$CLIENT_TTYS" >/dev/null 2>&1 || true
}

if tmux has-session -t "$PROJECT_SESSION" 2>/dev/null; then
  iterm_focus_or_attach
  exit 0
fi

tmux new-session -d -s "$PROJECT_SESSION" -n main -c "$PROJECT_DIR"
tmux split-window -v -t "$PROJECT_SESSION:0.0" -c "$PROJECT_DIR"
tmux select-pane -t "$PROJECT_SESSION:0.0"
tmux split-window -h -t "$PROJECT_SESSION:0.0" -c "$PROJECT_DIR"

tmux send-keys -t "$PROJECT_SESSION:0.0" 'cd www && npm run dev' C-m
tmux send-keys -t "$PROJECT_SESSION:0.1" 'cd www && php85 artisan queue:listen' C-m
tmux send-keys -t "$PROJECT_SESSION:0.2" 'cd www && claude' C-m

if [ -n "$PROJECT_EDITOR" ]; then
  /usr/bin/open -a "$PROJECT_EDITOR" "$PROJECT_EDITOR_TARGET" >/dev/null 2>&1 || true
fi

if [ -x "$SLATE_CLI_PATH" ]; then
  SLATE_EXT_ID="$SLATE_EXT_ID" /usr/bin/env bash "$SLATE_CLI_PATH" open "$PROJECT_CHROME_PROJECT" >/dev/null 2>&1 || true
fi

iterm_focus_or_attach
